{
  "name": "gameboy-emulator",
  "version": "1.0.0-rc.3",
  "author": "Alexandre Gaia",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:hardware": "node scripts/test-roms/fetch.mjs --acid2 --mbc1 --audio --mbc-extended",
    "test:hardware": "node scripts/run-hardware.mjs M12",
    "test:e2e": "playwright test",
    "preview:production": "node scripts/serve-production.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:audio-flow": "playwright test --config playwright.audio.config.ts",
    "benchmark:browser": "playwright test --config playwright.benchmark.config.ts",
    "benchmark:core": "vite build --ssr scripts/benchmarks/core.ts --outDir .work/bench-core && node .work/bench-core/core.js",
    "benchmark:rewind": "vite build --ssr scripts/benchmarks/rewind.ts --outDir .work/bench-rewind && node .work/bench-rewind/rewind.js",
    "check:rules": "node scripts/check-rules.mjs",
    "check": "npm run check:rules && npm run format:check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@noble/hashes": "2.4.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
